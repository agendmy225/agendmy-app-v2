rules_version = '2';

// ============================================================
// Regras de seguranca do AgendMy
// Cada colecao tem sua regra. Nao existe mais a regra generica
// que liberava escrita em tudo para qualquer usuario logado.
// ============================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- funcoes auxiliares ----------
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'admin';
    }

    function isBusinessOwner(businessId) {
      return signedIn() && businessId is string &&
        exists(/databases/$(database)/documents/businesses/$(businessId)) &&
        get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerId == request.auth.uid;
    }

    // profissional com acesso ao app ligado a esta conta
    function isProfessional(professionalId) {
      return signedIn() && professionalId is string &&
        exists(/databases/$(database)/documents/professionals/$(professionalId)) &&
        get(/databases/$(database)/documents/professionals/$(professionalId)).data.get('accessUserId', '') == request.auth.uid &&
        get(/databases/$(database)/documents/professionals/$(professionalId)).data.get('appAccess', false) == true;
    }

    // ---------- usuarios ----------
    match /users/{uid} {
      allow read: if signedIn();
      // ninguem se cadastra ja como admin
      allow create: if isSelf(uid) && !request.resource.data.keys().hasAny(['role']);
      // o proprio usuario edita seu perfil, mas nao pode mudar o "role"
      allow update: if isAdmin() ||
        (isSelf(uid) && request.resource.data.get('role', null) == resource.data.get('role', null));
      allow delete: if isAdmin();

      // aparelhos para notificacao (users/{uid}/tokens/{token})
      match /tokens/{tokenId} {
        allow read, write: if isSelf(uid);
      }
    }

    // admin conta os aparelhos registrados (collectionGroup 'tokens')
    match /{path=**}/tokens/{tokenId} {
      allow read: if isAdmin();
    }

    match /clients/{uid} {
      allow read: if signedIn();
      allow create, update: if isSelf(uid) || isAdmin();
      allow delete: if isAdmin();
    }

    match /owners/{uid} {
      allow read: if signedIn();
      allow create, update: if isSelf(uid) || isAdmin();
      allow delete: if isAdmin();
    }

    // ---------- estabelecimentos ----------
    match /businesses/{businessId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isAdmin() ||
        (signedIn() && resource.data.ownerId == request.auth.uid &&
         request.resource.data.ownerId == resource.data.ownerId &&
         // o dono nao mexe na propria assinatura
         !request.resource.data.diff(resource.data).affectedKeys().hasAny(['subscription', 'suspendedForPayment']) &&
         // suspenso por falta de pagamento nao se reativa sozinho
         (resource.data.get('suspendedForPayment', false) != true ||
          request.resource.data.get('active', false) == resource.data.get('active', false)));
      allow delete: if isAdmin();

      // tudo dentro do negocio (servicos, profissionais, relatorios...):
      // so o dono e o admin leem e escrevem
      match /{document=**} {
        allow read, write: if isBusinessOwner(businessId) || isAdmin();
      }

      // servicos e profissionais do negocio: publicos para leitura
      match /services/{serviceId} {
        allow read: if true;
      }
      match /professionals/{professionalId} {
        allow read: if true;
      }

      // avaliacoes: publicas para leitura; o cliente cria no proprio nome
      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if signedIn() && request.resource.data.userId == request.auth.uid &&
          request.resource.data.get('status', 'pending') == 'pending' &&
          request.resource.data.rating is number &&
          request.resource.data.rating >= 1 && request.resource.data.rating <= 5;
        // o autor pode editar o texto, mas nao aprovar a propria avaliacao
        allow update: if signedIn() && resource.data.userId == request.auth.uid &&
          request.resource.data.get('status', null) == resource.data.get('status', null);
        allow delete: if signedIn() && resource.data.userId == request.auth.uid;
      }
    }

    // leitura de avaliacoes de todos os negocios (collectionGroup 'reviews')
    match /{path=**}/reviews/{reviewId} {
      allow read: if true;
    }

    // avaliacoes no formato antigo (raiz)
    match /reviews/{reviewId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /professionals/{professionalId} {
      allow read: if true;
      allow create: if isBusinessOwner(request.resource.data.businessId) || isAdmin();
      allow update, delete: if isBusinessOwner(resource.data.businessId) || isAdmin();
      // o proprio profissional edita seus horarios e bloqueios
      allow update: if isProfessional(professionalId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['schedule', 'blockedDates', 'updatedAt']);
      // vinculo da conta do profissional usando um convite valido
      allow update: if signedIn() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['accessUserId', 'appAccess', 'inviteCode', 'updatedAt']) &&
        request.resource.data.accessUserId == request.auth.uid &&
        request.resource.data.appAccess == true &&
        request.resource.data.inviteCode is string &&
        exists(/databases/$(database)/documents/professionalInvites/$(request.resource.data.inviteCode)) &&
        get(/databases/$(database)/documents/professionalInvites/$(request.resource.data.inviteCode)).data.professionalId == professionalId &&
        get(/databases/$(database)/documents/professionalInvites/$(request.resource.data.inviteCode)).data.status == 'pending';
    }

    match /services/{serviceId} {
      allow read: if true;
      allow create: if isBusinessOwner(request.resource.data.businessId) || isAdmin();
      allow update, delete: if isBusinessOwner(resource.data.businessId) || isAdmin();
    }

    match /businessLocations/{locationId} {
      allow read: if true;
      allow create: if isBusinessOwner(request.resource.data.businessId) || isAdmin();
      allow update, delete: if isBusinessOwner(resource.data.businessId) || isAdmin();
    }

    // ---------- agendamentos ----------
    match /appointments/{appointmentId} {
      // leitura aberta para logados: o cliente precisa ver os horarios ocupados
      allow read: if signedIn();
      // cliente: so no proprio nome e sempre aguardando a confirmacao do estabelecimento
      allow create: if signedIn() &&
        ((request.resource.data.clientId == request.auth.uid &&
          request.resource.data.status == 'scheduled') ||
         isBusinessOwner(request.resource.data.businessId) ||
         isProfessional(request.resource.data.professionalId));
      allow update: if isAdmin() ||
        isBusinessOwner(resource.data.businessId) ||
        isProfessional(resource.data.professionalId) ||
        // cliente: so cancela (enquanto aberto) e marca como avaliado
        (signedIn() && resource.data.clientId == request.auth.uid &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewed', 'updatedAt']) &&
         (request.resource.data.status == resource.data.status ||
          (request.resource.data.status == 'cancelled' &&
           resource.data.status in ['scheduled', 'confirmed'])));
      allow delete: if isAdmin() || isBusinessOwner(resource.data.businessId);
    }

    // ---------- convites de profissionais ----------
    match /professionalInvites/{code} {
      allow read: if signedIn();
      allow create: if isBusinessOwner(request.resource.data.businessId) && request.resource.data.status == 'pending';
      allow update: if isBusinessOwner(resource.data.businessId) ||
        (signedIn() && resource.data.status == 'pending' && request.resource.data.status == 'used' &&
         request.resource.data.usedBy == request.auth.uid &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'usedBy', 'usedAt']));
      allow delete: if isBusinessOwner(resource.data.businessId) || isAdmin();
    }

    // ---------- favoritos ----------
    match /favorites/{favoriteId} {
      // o id do favorito e "uid_businessId": da para checar mesmo se ainda nao existe
      allow read: if signedIn() &&
        (favoriteId.matches(request.auth.uid + '_.*') || resource.data.userId == request.auth.uid);
      allow create, update: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    // ---------- chats (mantidas como estavam) ----------
    match /chats/{chatId} {
      allow read, write: if request.auth != null &&
        (request.auth.uid in resource.data.participants ||
         (request.resource != null && request.auth.uid in request.resource.data.participants));
    }

    match /chats/{chatId}/messages/{messageId} {
      allow read, write: if request.auth != null &&
        (exists(/databases/$(database)/documents/chats/$(chatId)) &&
         request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants);
    }

    // ---------- notificacoes internas ----------
    match /notifications/{notificationId} {
      allow read, update, delete: if signedIn() && resource.data.userId == request.auth.uid;
      // o dono cria notificacoes para o cliente (ex: confirmacao de agendamento)
      allow create: if signedIn();
    }

    match /notificationSettings/{userId} {
      allow read: if signedIn();
      // as configuracoes padrao podem ser criadas por quem confirma um agendamento
      allow create: if signedIn();
      allow update, delete: if isSelf(userId) || isAdmin();
    }

    // ---------- painel admin ----------
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /announcements/{announcementId} {
      allow read: if signedIn();
      // o envio e feito pela Cloud Function, que nao passa por estas regras
      allow create, update, delete: if isAdmin();
    }
  }
}
